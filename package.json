{
  "name": "strapi-plugin-global-filters",
  "version": "2.0.0",
  "description": "Always-on, sticky list filters for the Strapi 5 Content Manager: pick which fields become quick filters per content type; selections persist across reloads and navigation.",
  "keywords": [
    "strapi",
    "plugin",
    "strapi-plugin",
    "content-manager",
    "filters",
    "list-view"
  ],
  "license": "MIT",
  "author": {
    "name": "Ihor Sahaidak"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ihorsahaidak/strapi-plugin-global-filters.git"
  },
  "homepage": "https://github.com/ihorsahaidak/strapi-plugin-global-filters#readme",
  "bugs": {
    "url": "https://github.com/ihorsahaidak/strapi-plugin-global-filters/issues"
  },
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "source": "./server/src/index.js",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify"
  },
  "devDependencies": {
    "@strapi/design-system": "^2.0.0",
    "@strapi/icons": "^2.0.0",
    "@strapi/sdk-plugin": "^5.3.2",
    "@strapi/strapi": "^5.0.0",
    "@strapi/typescript-utils": "^5.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "styled-components": "^6.1.13",
    "typescript": "^5.5.4"
  },
  "peerDependencies": {
    "@strapi/design-system": "^2.0.0",
    "@strapi/icons": "^2.0.0",
    "@strapi/strapi": "^5.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.0.0",
    "styled-components": "^6.0.0"
  },
  "strapi": {
    "kind": "plugin",
    "name": "global-filters",
    "displayName": "Global Filters",
    "description": "Always-on, sticky list filters for the Content Manager, configurable per content type."
  },
  "engines": {
    "node": ">=18.0.0 <=22.x.x",
    "npm": ">=6.0.0"
  }
}
